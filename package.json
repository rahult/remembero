{
  "name": "remembero",
  "version": "0.56.0",
  "description": "Logic-based memory for LLM chats and agents: deterministic Datalog rules, explicit entity identity, integrity, provenance, graphs, and MCP",
  "type": "module",
  "bin": {
    "remembero": "dist/cli.js",
    "remembero-web": "dist/web/server.js",
    "rembero": "dist/cli.js",
    "rembero-web": "dist/web/server.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
