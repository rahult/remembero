  "scripts": {
    "build": "npm run build:core && npm run check:web && npm run build:web",
    "build:core": "tsc -p tsconfig.json",
    "check:web": "tsc -p web/tsconfig.json --noEmit",
    "build:web": "vite build --config web/vite.config.ts",
    "build:sqlite": "sh native/build.sh",
    "build:sqlite:wasm": "sh native/build-wasm.sh",
    "web:dev": "tsx src/web/server.ts --dev --demo",
    "web:start": "node dist/web/server.js --demo",
    "web": "npm run build && npm run web:start",
    "pretest": "npm run build",
    "pretest:sqlite": "npm run build",
    "test": "vitest run",
    "test:sqlite": "vitest run tests/sqlite-extension.test.ts tests/sqlite-memory-store.test.ts tests/sqlite-memory-mcp.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "check:package-policy": "npm run build && node scripts/check-package-policy.mjs",
    "eval:extract": "npm run build && node dist/evals/run-extraction.js",
    "eval:recall": "npm run build && node dist/evals/run-recall.js",
    "eval:documents": "npm run build:core && node dist/evals/run-document-showcase.js",
    "export:documents:memorg": "npm run build:core && node dist/evals/run-document-memorg.js --check --output docs/research/results/document-intelligence.memorg.json --public-output web/public/documents/document-intelligence.memorg.json",
    "eval:ocr:live": "npm run build:core && node dist/evals/run-unlimited-ocr-live.js",
    "bench:memory": "npm run build && node dist/evals/run-memory-stack.js",
    "bench:memory:check": "npm run build && node dist/evals/run-memory-stack.js --check",
    "bench:memory:langgraph": "npm run build:core && node dist/evals/run-memory-stack.js --adapters rembero --external-manifest benchmarks/adapters/langgraph-fastembed/adapter.json",
    "bench:memory:llamaindex": "npm run build:core && node dist/evals/run-memory-stack.js --adapters rembero --external-manifest benchmarks/adapters/llamaindex-fastembed/adapter.json",
    "bench:memory:external": "npm run build:core && node dist/evals/run-memory-stack.js --adapters rembero --external-manifest benchmarks/adapters/langgraph-fastembed/adapter.json --external-manifest benchmarks/adapters/llamaindex-fastembed/adapter.json",
    "bench:memory:mem0": "npm run build:core && node dist/evals/run-memory-stack.js --adapters rembero --external-manifest benchmarks/adapters/mem0-openrouter-fastembed/adapter.json",
    "bench:memory:graphiti": "npm run build:core && node dist/evals/run-memory-stack.js --adapters rembero --external-manifest benchmarks/adapters/graphiti-openrouter-fastembed/adapter.json",
    "bench:longmemeval:download": "npm run build:core && node dist/evals/run-longmemeval.js --download-only",
    "bench:longmemeval": "npm run build:core && node dist/evals/run-longmemeval.js",
    "bench:longmemeval:semantic": "npm run build:core && node dist/evals/run-longmemeval-semantic.js",
    "bench:longmemeval:answer": "npm run build:core && node dist/evals/run-longmemeval-answer.js",
    "bench:longmemeval:v2:prepare": "node benchmarks/adapters/longmemeval-v2/prepare_text_subset.mjs",
    "bench:agent-db": "npm run build && node dist/evals/run-agent-db-scorecard.js",
    "bench:agent-db:check": "npm run build && node dist/evals/run-agent-db-scorecard.js --check",
    "bench:agent-db:scale": "npm run build:core && node dist/evals/run-agent-db-scale.js",
    "bench:agent-db:million": "npm run build:core && node --expose-gc --max-old-space-size=4096 dist/evals/run-agent-db-scale.js --facts 1000000 --repetitions 3 --check-million",
    "bench:agent-db:cost": "npm run build && node dist/evals/run-recall.js --variants grounded",
    "bench:agent-db:install": "npm run build:core && node dist/evals/run-agent-db-install.js",
    "bench:agent-db:install:check": "npm run build:core && node dist/evals/run-agent-db-install.js --check",
    "bench:engine": "npm run build && node dist/evals/run-engine-benchmark.js",
    "test:watch": "vitest",
    "ship:check": "npm test && npm run test:package && npm run check:package-policy && npm run bench:memory:check && npm run bench:agent-db:check && npm run eval:documents -- --check && npm run export:documents:memorg && python3 scripts/import-document-memorg.py docs/research/results/document-intelligence.memorg.json --dry-run && npm audit --audit-level=high",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run ship:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahult/remembero.git"
  },
  "keywords": [
    "memory",
    "datalog",
    "prolog",
    "mcp",
    "model-context-protocol",
    "llm",
    "agent",
    "claude",
    "knowledge-base",
    "reasoning"
  ],
  "author": "Rahul Trikha",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
